{
  "name": "my-pi-setup",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Small, independent Pi extensions for a personal setup.",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "packages/*/index.ts"
    ]
  },
  "scripts": {
    "test": "tsx --test packages/*/tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.86.1",
    "@earendil-works/pi-coding-agent": "0.86.1",
    "@earendil-works/pi-tui": "^0.86.1",
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typebox": "1.3.27",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
